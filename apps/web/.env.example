# The planning server's public origin. Required for a production build.
# It must share a site with the web app (app.example.com and api.example.com): the
# session is a cookie set by the API, and browsers that block third-party cookies
# (Safari always) will not send it to another site.
NEXT_PUBLIC_API_BASE=https://api.example.com

# Shown on the Privacy and Terms pages. Google's OAuth review asks for a contact.
NEXT_PUBLIC_CONTACT_EMAIL=

# Development only: sign in as the server's fixture account instead of Google.
# NEXT_PUBLIC_FIXTURE=1

# Or serve the API under this site's own address, which needs only one host name:
# NEXT_PUBLIC_API_BASE=same-origin
# API_PROXY_TARGET=http://localhost:8080      # where this server forwards /v1/… to
