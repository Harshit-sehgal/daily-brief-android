<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Launch theme only. Everything visible is drawn by Compose; this exists so
        the window behind it matches the app background instead of flashing the
        platform default before the first frame.
    -->
    <style name="Theme.DailyBrief" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
