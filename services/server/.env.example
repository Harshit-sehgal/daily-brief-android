# Everything the server reads (Config.kt). It fails at boot, naming the variable, when a
# required one is missing. Copy to .env; never commit the copy.

# ── required ────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://db.example.internal:5432/dailybrief
DATABASE_USER=dailybrief
DATABASE_PASSWORD=
# At least 32 characters. Signs sessions, CSRF tokens and OAuth state: rotating it signs everyone out.
SESSION_SECRET=
# The web client's exact origin. CORS admits only this, and the OAuth redirect is
# ${WEB_ORIGIN}/auth/callback. https here is what marks the session cookie Secure.
WEB_ORIGIN=https://app.example.com
PORT=8080

# ── token encryption: one of the two ────────────────────────────────────────
# A 32-byte hex key (head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'). Losing it
# makes every stored Google token and note unreadable.
ENVELOPE_KEY_HEX=
# …or AWS KMS, which wins when set.
# AWS_KMS_KEY_ID=
# AWS_KMS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Google sign-in, calendar and Drive ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── optional: each feature stays off, and says so, until its keys are present ─
# GEMINI_API_KEY=            # the written brief
# STRIPE_SECRET_KEY=         # paid plans (all three together)
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# EXPO_ACCESS_TOKEN=         # push to the phone app

# Never in production: replaces Google with a fixture account anyone can sign in as.
# FIXTURE_PROVIDER=1
