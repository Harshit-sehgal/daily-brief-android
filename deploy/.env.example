# Copy to deploy/.env. Never commit the copy.

# Two names on the same registrable domain, both pointing at this machine.
APP_HOST=app.example.com
API_HOST=api.example.com
CONTACT_EMAIL=you@example.com

DATABASE_PASSWORD=
# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -hex 32   — back this up apart from the database; without it stored
# Google tokens and notes cannot be read.
ENVELOPE_KEY_HEX=

# From the Google Cloud OAuth client (docs/saas/12-going-public.md, step 2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional; each feature stays off until its key is set.
# GEMINI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# EXPO_ACCESS_TOKEN=
